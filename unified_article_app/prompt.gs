function uaBuildArticlePrompt_(rowData, appConfig) {
  const internalLinksPrompt = appConfig && appConfig.useInternalLinks
    ? uaBuildInternalLinksPrompt_(rowData.mainInput, appConfig)
    : '';
  const externalSourcesPrompt = uaBuildExternalSourcesPrompt_(rowData.mainInput, appConfig);
  const affiliatePrompt = uaBuildAffiliatePrompt_(rowData);
  const competitorPrompt = uaBuildCompetitorPrompt_(rowData);
  const readerMindMemo = String(rowData.readerMindMemo || '').trim();

  if (appConfig.key === 'home') {
    return uaBuildHomeArticlePrompt_(rowData, affiliatePrompt, competitorPrompt, internalLinksPrompt, externalSourcesPrompt, readerMindMemo);
  }

  if (appConfig.key === 'general') {
    return uaBuildGeneralArticlePrompt_(rowData, affiliatePrompt, competitorPrompt, externalSourcesPrompt, readerMindMemo);
  }

  return uaBuildDriveArticlePrompt_(rowData, affiliatePrompt, competitorPrompt, internalLinksPrompt, externalSourcesPrompt, readerMindMemo);
}

function uaBuildAffiliatePrompt_(rowData) {
  const name = String(rowData.affiliateName || '').trim();
  const url = String(rowData.affiliateUrl || '').trim();
  const notes = String(rowData.affiliateNotes || '').trim();

  if (!name && !url) {
    return 'メイン案件は未入力です。アフィリエイトリンクは入れないでください。';
  }

  if (name && !url) {
    return [
      'メイン案件名: ' + name,
      'メインアフィリエイトURL: 未入力',
      '案件注意点: ' + (notes || '特になし'),
      'URLが未入力のため、アフィリエイトリンクは入れないでください。',
      'ただし文脈に自然に合う場合は、案件名を選択肢のひとつとして1回だけ触れても構いません。'
    ].join('\n');
  }

  if (!name && url) {
    return [
      'メイン案件名: 未入力',
      'メインアフィリエイトURL: ' + url,
      '案件注意点: ' + (notes || '特になし'),
      '案件名が未入力のため、アフィリエイトリンクは入れないでください。'
    ].join('\n');
  }

  return [
    'メイン案件名: ' + name,
    'メインアフィリエイトURL: ' + url,
    '案件注意点: ' + (notes || '特になし'),
    '本文内に1〜2回まで、売り込みではなく選択肢のひとつとして入れてください。',
    'アフィリエイトリンクは本文に溶け込ませすぎず、読者が「こういう商品・サービスもある」と分かる文脈にしてください。',
    'リンク前には、必要に応じて「専門業者に相談するなら」「具体的な商品を見て比較したい場合は」「こういう選択肢もあります」「まず対応内容を確認したい場合は」のような短い前置きを入れてください。',
    'リンク直前では、「買う」よりも「悩みを解決できる選択肢があるか確認する」「自分の車種・暮らしに合うか見る」「施工例や対応内容を確認する」というクリック理由を作ってください。',
    '読者が「この悩みを解決するものがあるかもしれない」と感じる導線にしてください。',
    'ただし「絶対おすすめ」「最安」「一番良い」などの断定や、購入を急がせる表現は使わないでください。',
    '導入文、「この記事のポイント」、Q&A内には入れないでください。',
    'リンク形式は <a href=\'' + url + '\' rel=\'nofollow sponsored\'>自然なアンカーテキスト</a> としてください。'
  ].join('\n');
}

function uaBuildCompetitorPrompt_(rowData) {
  const urls = [
    rowData.competitorUrl1,
    rowData.competitorUrl2,
    rowData.competitorUrl3
  ].map(function(url) {
    return String(url || '').trim();
  }).filter(Boolean);

  if (urls.length === 0) {
    return '競合URLは未入力です。検索意図と読者心理メモを優先してください。';
  }

  const pages = urls.map(function(url) {
    return uaFetchCompetitorPageInfo_(url);
  });

  return [
    '競合・参考URL:',
    pages.map(function(item, index) {
      return [
        (index + 1) + '. URL: ' + item.url,
        '取得状況: ' + (item.fetchStatus || '不明'),
        'タイトル: ' + (item.title || '取得できませんでした'),
        'メタディスクリプション: ' + (item.description || 'なし'),
        '見出し構成:',
        (item.headings && item.headings.length ? item.headings.join('\n') : '取得できませんでした'),
        '本文抽出:',
        item.bodyText || '取得できませんでした',
        '抽出キーワード: ' + (item.keywords || 'なし')
      ].join('\n');
    }).join('\n\n'),
    '本文で使う具体確認リンク候補:',
    pages.map(function(item, index) {
      return [
        (index + 1) + '. ' + item.url,
        'リンク文言候補: ' + (item.title || '公式ページ')
      ].join('\n');
    }).join('\n'),
    '競合・参考URLは、検索意図、上位記事の構成、本文で扱われている論点、公式サービス名、費用・プラン名、読者が確認したい判断材料を拾うために使ってください。',
    '本文を書く前提として、競合・参考URLから次の4点を内部で整理してください: 1. 共通して扱われている見出し・論点 2. 公式ページや上位記事が強く説明している内容 3. 読者が不安に感じるのに薄く扱われている不足論点 4. DRIVE BASE/たくみパパ/汎用記事として差をつける判断軸。',
    '記事本文には、競合分析そのものを「競合では〜」のように書かず、分析結果を自然に反映してください。',
    '取得状況（HTTP 403、取得失敗、取得できませんでした等）は内部処理メモです。本文には絶対に書かないでください。',
    'URL本文を取得できない場合でも、URL文字列・タイトル・URLヒントから分かる範囲で、公式確認リンクとして扱えるかを検討してください。ただし取得できなかったページ内容を事実として断定しないでください。',
    '公式サイトや店舗公式ページが含まれる場合は、本文内で重要なサービス名・プラン名・確認先として自然に触れてください。',
    '取得した公式ページのタイトル、見出し、本文抽出に具体的なサービス名・プラン名・キャンペーン名・料金体系名がある場合は、該当する本文セクションで必ず1回以上触れてください。',
    '公式サービス名・プラン名・料金体系名が記事テーマの中心に近い場合は、独立したH2またはH3を作り、「何が含まれるか」「対象外や追加費用になりやすい条件」「見積もり前に確認すること」まで具体的に説明してください。',
    '公式サイトや店舗公式ページのURLは、記事テーマと直接関係する場合、トップページへ逃がさず、「本文で使う具体確認リンク候補」にある具体URLを本文中の確認リンクとして1回は使ってください。',
    '禁止: 具体ページURLがあるのに、同じドメインのトップページやカテゴリトップへ置き換えないでください。',
    '具体的なサービス名・プラン名を本文に入れるときは、宣伝ではなく「公式ページで確認できる選択肢」「見積もり前に確認したい項目」として扱ってください。',
    '取得できた公式サービス名・プラン名を本文に反映しなかった場合は、fact_check_points に「・競合URLの公式サービス名未反映｜該当URL」と出してください。',
    'ただし、本文中に競合URLをそのまま貼る必要はありません。丸写し、長い引用、事実の断定しすぎは避けてください。',
    '取得できなかったURLがある場合は、そのURLの内容を推測で本文に入れず、必要なら fact_check_points に確認事項として出してください。'
  ].join('\n');
}

function uaBuildReaderMindUsageRules_() {
  return `
読者心理メモの使い方:
・読者心理メモがある場合は、記事設計の中心材料として使う。
・導入文では「導入文で拾う本音」「読者の葛藤」から、読者が最初に感じている不安・迷いを具体的に拾う。
・本文構成では「見出し順のヒント」をそのまま丸写しせず、検索意図と競合・参考URLの構成を見たうえで、自然なH2/H3に再構成する。
・本文では「顕在ニーズ」に早めに答え、「潜在ニーズ」「読者の葛藤」は比較表、向いているケース、慎重に考えたいケース、注意点、まとめで回収する。
・「記事で深掘りすると刺さる判断軸」は、本文の独自性を出す重要材料として使う。単なる一般論で終わらせず、読者が自分で判断できる形にする。
・「本文で優先して扱う材料」がある場合は、本文の主軸、冒頭の答え、前半H2、比較表、判断軸に優先して反映する。
・「FAQに回す材料」がある場合は、FAQ候補と合わせて、本文で深掘りしすぎると主題が散る補足疑問として回収する。
・「今回は主役にしない材料」がある場合は、本文の主軸にしない。必要なら一文の注意、内部リンク、関連補足、fact_check_pointsに回す。
・「FAQ候補」はよくある質問の材料として優先的に使う。ただし本文で十分に解決した内容は重複させすぎない。
・「主役にしない補足テーマ」は、本文の主軸にせず、必要なら内部リンク候補・補足・一文の注意として軽く扱う。
・「本文で事実として使わない方がよいもの」は、本文で断定しない。古い情報、個人の体験談、Q&Aサイト由来の未確認情報は一般傾向として書かない。
・安全、法規、価格、保証、メーカー仕様などは、読者心理メモよりも公式情報・外部出典・確認ポイントを優先する。
・読者心理メモの見出し名（顕在ニーズ、潜在ニーズ等）は本文にそのまま出さない。記事の自然な文章として反映する。
`;
}

function uaBuildArticlePlanningOrderRules_() {
  return `
記事構成を作る順序:
1. まず読者心理メモを読み、誰のどんな悩みに答える記事かを固定する。顕在ニーズ、潜在ニーズ、読者の葛藤、導入文で拾う本音、本文で優先して扱う材料、FAQに回す材料、今回は主役にしない材料、使わない方がよい情報を整理する。
2. 次に競合・参考URLを読み、上位記事や公式ページで共通して扱われている必須論点、公式サービス名、費用・プラン・対応可否などの確認事項を整理する。
3. 読者心理メモと競合・参考URLを照合し、読者の不安を解く順番に見出しを組み直す。競合URLの見出し順をそのままなぞらない。
4. 法規、安全、価格、保証、メーカー仕様、施工可否などの事実系は、外部出典・公式情報・確認ポイントを優先する。読者心理メモや競合記事だけを根拠に断定しない。
5. 内部リンク、外部リンク、案件リンクは、本文構成が決まった後に、読者の次の確認や選択肢として自然な位置へ置く。リンクを先に主役にしない。
6. 最後に、DRIVE BASE/たくみパパ/汎用記事としての独自視点を足す。単なる上位記事の要約ではなく、読者が自分で判断できる軸を入れる。

競合・参考URLの扱い:
・競合・参考URLはコピー元ではなく、検索意図、必須論点、不足論点を把握するための材料として使う。
・競合記事の文章、見出しの言い回し、比較表、独自レビュー、体験談をコピーしない。
・競合URLから得た情報は、読者心理メモ、公式情報、外部出典、独自の判断軸をもとに抽象化して再構成する。
・競合記事だけに書かれている未確認情報は、事実として断定しない。必要なら fact_check_points に確認事項として出す。
`;
}

function uaCommonOutputRules_() {
  return `
【共通出力ルール】
・WordPressのコードエディターに直接貼れるHTML本文を書く。
・本文はいきなり <p> から始める。<h1> は使わない。
・使用タグは <p>、<h2>、<h3>、<h4>、<ul>、<li>、<strong>、<span>、<a>、<figure>、<table>、<thead>、<tbody>、<tr>、<th>、<td> のみ。
・HTML属性は原則シングルクォートを使う。
・比較表は必要に応じて1つ入れる。表は <!-- wp:table --><figure class='wp-block-table'><table>...</table></figure><!-- /wp:table --> の形式。
・導入文の後に「この記事のポイント」を <p><strong>この記事のポイント</strong></p> と <ul><li>...</li></ul> で4つ入れる。
・title_ideas の各タイトル案には、メインキーワードを必ず自然に含める。各案は必ず28〜32文字程度に収める。
・title_ideas は3案を「案1 / 案2 / 案3」の形式で出す。ただし各案のタイトル本文の中に「/」や「／」を使わない。
・title_ideas は、理由、注意点、手順、比較、チェック項目など数字で整理できるテーマでは「3つの理由」「5つの注意点」「7項目」などの数字を使ってよい。ただし数字を入れるために28〜32文字を超えない。
・title_ideas は情報を詰め込みすぎない。「総額」「持ち込み」「追加料金」「保証」など複数論点を全部入れず、1案につき主な訴求は1つに絞る。
・H2見出しは長くなりすぎないよう、メインキーワードまたは関連キーワードを自然に含めつつ31文字以内を目指す。
・H2見出しも、理由、注意点、手順、比較、チェック項目など数字で整理できる場面では数字を積極的に使う。
・H2見出しで無理にキーワードを詰め込まず、読者が内容を一目で理解できる短い表現を優先する。
・Q&Aは <h2>よくある質問</h2>、質問は <h4>Q. ...</h4>、回答は <p>A. ...</p>。
・Q&Aのあとに必ずまとめを入れ、Q&Aで終わらせない。
・強調マーカーは3〜5か所まで。<span style='background:linear-gradient(transparent 60%, #fff3a3 60%);'><strong>強調文</strong></span> を使う。
・危険や強い注意は必要な場合のみ <span style='color:#d93025;'><strong>強調文</strong></span> を使う。
・「おすすめです」「〜することが大切です」「結論から言うと」は使わない。
・AI Overviewや生成AIに引用されやすいように、重要なH2直下の最初の段落には、その見出しへの答えを自己完結した1〜2文で入れる。
・重要な説明では「この」「それ」「その場合」だけで始めず、主語・対象・条件を文内に戻して書く。
・1文に複数の主張を詰め込まない。原則として、1文につき1つの判断・理由・注意点に分ける。
・数値、年式、価格、法規、安全、メーカー仕様、対応可否などは、対象・時点・範囲をできるだけ文内に入れる。
・出典リンクを使う場合は、根拠にした説明と同じ段落、または直後の段落に自然なテキストリンクとして入れる。
・比較表の前後には、表だけを見ても判断軸が分かる短い要約文を入れる。
・各主要セクションの終わりには、必要に応じて「つまり何を確認するか」が分かる短い一文を置く。
・見出しは、読者にもAIにも段落の役割が分かるように「理由」「注意点」「比較」「判断基準」「チェックリスト」「よくある質問」などの機能が伝わる表現にする。
・H3見出しを作る場合は、見出し名だけで終わらせず、そのH3内で「答え・理由・具体例・確認ポイント」のうち最低3つを必ず入れる。
・H3の本文は薄い箇条書きだけにしない。必要に応じて本文2〜4段落、または本文1〜2段落＋箇条書きで、読者がその場で判断できる厚みにする。
・H3が連続する場合でも、同じ型の説明を繰り返さない。費用、手間、安全、保証、見た目、使い勝手など、H3ごとに違う判断材料を出す。
・公式サービス名、プラン名、料金体系名を扱うH3では、「何が含まれるか」「対象外になりやすい条件」「見積もり前に確認すること」まで具体化する。
・費用、工賃、料金、価格、総額、相場、見積もりが検索意図の中心にある記事では、前半に「総額の内訳」または「費用が動く項目」の表を必ず入れる。
・費用系の記事では、公式サイト、メーカー公式、店舗公式、公的機関、外部出典候補に金額・工賃・料金表・価格レンジがあるかを優先的に確認する。取得できた公式金額は、本文前半で「公式に確認できる目安」として具体的な数字で出す。
・費用レンジや工賃目安を書く場合は、対象、時点、含まれる範囲、店舗差、追加条件を必ず添える。根拠が弱い金額は断定せず、fact_check_points に確認事項として出す。
・公式金額を確認できない場合でも、金額を避けて一般論だけに逃げない。「標準に含まれやすいもの」「追加費用になりやすいもの」「店舗・公式で確認する質問文」を具体的に出す。
・見出しに「目安」「相場」「いくら」を使う場合は、そのセクション内に具体的な金額、料金表、または金額を確認する公式リンクを必ず入れる。数字を出せない場合は、見出しを「費用が変わるポイント」「総額の見方」などに変える。
・見積もりが必要なテーマでは、読者がそのまま店舗・施工会社・メーカーへ伝えられる短い質問文または確認テンプレートを本文中に1つ入れる。
・「つまり、」で始まる小括は本文全体で多用しない。使う場合は最大2回までにし、「見積書を見るときは」「最初に決めたいのは」「店舗側が判断できるように」など、文脈に合う自然な言い換えを使う。
・体験談や感想は、事実確認が必要な説明と混ぜすぎない。体験談のあとに一般化する場合は「この経験から言えるのは」のように範囲を明確にする。
・本文全体は、話題導入→条件つきの答え→理由→具体例→確認ポイント→小さな行動、の流れを意識する。
・商品や道具で解決できるテーマでは、記事後半に「例えば、こういうものを使ってみるのもよさそうです」「まずはこういう定番アイテムから試すと始めやすいです」のような、楽天バナーや商品提案と相性のよい導線文を自然に入れてよい。
・有名メーカーや定番ブランドの商品名は、記事テーマに合う場合のみ1〜3個まで比較・検討候補として出してよい。ただし実使用レビューのように書かず、価格・順位・性能を断定しない。
・meta_description は120〜140文字。短すぎる要約にせず、メインキーワード、読者の悩み、記事で分かること、読むメリットを自然に入れる。
・meta_description は本文の単なる切り抜きではなく、検索結果で読みたくなる説明文にする。ただし煽りや誇張は避ける。
・tags は8〜10個。できれば10個出す。短い単語または短い複合語にし、カンマ区切りにする。
・tags に本文と関係の薄い一般タグを入れない。メインキーワード、読者の悩み、比較対象、用途、ジャンルから自然に選ぶ。
・fact_check_points は最大5個。形式は「・確認事項｜確認先URL」。確認先が不明なら「確認先不明」。
・structure_memo には、本文には出さない内部メモとして、読者心理メモと競合・参考URLから何を拾い、どう見出し構成に反映したかをテキストで残す。
・structure_memo は次の形式で書く。「【読者心理から拾った材料】」「【競合・参考URLから拾った材料】」「【見出し構成に使った判断】」「【確定したH2/H3構成】」の4項目に分ける。
・structure_memo の【読者心理から拾った材料】では、読者心理メモ内の「本文で優先して扱う材料」「FAQに回す材料」「今回は主役にしない材料」を要約し、本文構成上の扱いが分かるようにする。
・structure_memo では、競合本文の文章を引用・コピーしない。論点、確認事項、差別化軸として短く要約する。
・structure_memo の【確定したH2/H3構成】には、実際に本文で使ったH2/H3を順番どおりに並べる。
・回答は必ずJSONのみ。Markdownやコードブロックは禁止。

{
  "title_ideas": "案1 / 案2 / 案3",
  "meta_description": "120〜140文字の魅力的なメタディスクリプション",
  "permalink": "english-slug",
  "body": "HTML本文",
  "tags": "タグ1,タグ2,タグ3,タグ4,タグ5,タグ6,タグ7,タグ8,タグ9,タグ10",
  "fact_check_points": "・確認事項｜確認先URL",
  "structure_memo": "【読者心理から拾った材料】...\\n【競合・参考URLから拾った材料】...\\n【見出し構成に使った判断】...\\n【確定したH2/H3構成】..."
}
`;
}

function uaBuildDriveArticlePrompt_(rowData, affiliatePrompt, competitorPrompt, internalLinksPrompt, externalSourcesPrompt, readerMindMemo) {
  return `
あなたは「DRIVE BASE」の記事を書く車メディアの編集者です。
車の整備・用品・カスタム・運転の悩みについて、検索読者が自分で判断できる記事を書いてください。

書き手設定:
・一人称は必要な場合のみ「ケイ」。
・整備士専門学校で車の基礎を学び、整備工場で研修経験がある。
・大型トラックの運転経験があり、長距離運転や車内待機の実感を持つ。
・ただし、体験談は商品レビューや特定車種の使用体験として盛らない。
・一次情報は、施工品質、配線処理、長距離運転時の小さなストレス、車の状態を見る判断軸として1〜2か所だけ自然に入れる。

メインキーワード: ${rowData.mainInput}
検索ボリューム: ${rowData.volume || '未入力'}

読者心理メモ:
${readerMindMemo || '未入力'}

${uaBuildReaderMindUsageRules_()}

${uaBuildArticlePlanningOrderRules_()}

${competitorPrompt}

${internalLinksPrompt}

${externalSourcesPrompt}

${affiliatePrompt}

本文方針:
・5000〜7500字程度。
・最初の3文で読者の不安に入る。
・DRIVE BASEは、車選び・車内快適化・後付け装備で迷う読者に、運転者目線の判断軸を渡すメディアとして書く。
・安全、法規、車検、保証、メーカー仕様は断定しすぎず、公式確認の導線を置く。
・読者が迷いやすいテーマでは、「自分ならどの条件で選ぶか」を1段落だけ自然に入れる。
・アフィリエイトリンクがある場合も、売り込みより「選択肢のひとつ」に留める。
・案件リンクは、向いている条件・注意点・確認ポイントを説明した後に、選択肢のひとつとして入れる。
・洗車、車内清掃、コーティング、タイヤ、電装品、車中泊用品など、カー用品で解決できるテーマでは、記事後半に「選ぶときのポイント」または「用意すると便利なもの」の見出しを自然に入れる。
・商品提案は、いきなり特定商品名を並べず、「初心者向け」「価格を抑えたい人向け」「仕上がり重視」「時短重視」のように読者の使い方別に整理する。
・商品提案セクションでは、必要に応じて「ブランド名 + 商品カテゴリ」または「定番メーカー + 用途」を自然な本文で1〜3個だけ出してよい。
・商品導線は「例えば、こういうものを使ってみるのもよさそうです」「迷ったら、まずはこういう定番アイテムから試すと始めやすいです」のように、読者の次の行動として軽く置く。
・メイン案件名とURLがある場合は、その商品の押し売りではなく、上記の商品提案セクション内で選択肢のひとつとして自然に紹介する。
・メイン案件がない場合でも、商品カテゴリ名（例: カーシャンプー、マイクロファイバークロス、ガラスクリーナー、油膜取り、コーティング剤、タイヤワックスなど）は必要に応じて出してよい。
・ただし、公式情報や案件指示がない具体的な商品名・型番・価格・性能ランキングは断定しない。
・最後は読者が次にできる行動を具体的に示す。

${uaCommonOutputRules_()}
`;
}

