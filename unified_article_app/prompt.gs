function uaBuildCompetitorPrompt_(rowData) {
  const urls = [
    rowData.competitorUrl1,
    rowData.competitorUrl2,
    rowData.competitorUrl3
  ].map(function(url) {
    return String(url || '').trim();
  }).filter(Boolean);

  if (urls.length === 0) {
    return '競合URLは未入力です。検索意図と読者心理メモを優先してください。';
  }

  const pages = urls.map(function(url) {
    return uaFetchCompetitorPageInfo_(url);
  });

  return [
    '競合・参考URL:',
    pages.map(function(item, index) {
      return [
        (index + 1) + '. URL: ' + item.url,
        '取得状況: ' + (item.fetchStatus || '不明'),
        'タイトル: ' + (item.title || '取得できませんでした'),
        'メタディスクリプション: ' + (item.description || 'なし'),
        '見出し構成:',
        (item.headings && item.headings.length ? item.headings.join('\n') : '取得できませんでした'),
        '本文抽出:',
        item.bodyText || '取得できませんでした',
        '抽出キーワード: ' + (item.keywords || 'なし')
      ].join('\n');
    }).join('\n\n'),
    '競合・参考URLは、検索意図、上位記事の構成、本文で扱われている論点、公式サービス名、費用・プラン名、読者が確認したい判断材料を拾うために使ってください。',
    '本文を書く前提として、競合・参考URLから次の4点を内部で整理してください: 1. 共通して扱われている見出し・論点 2. 公式ページや上位記事が強く説明している内容 3. 読者が不安に感じるのに薄く扱われている不足論点 4. DRIVE BASE/たくみパパ/汎用記事として差をつける判断軸。',
    '記事本文には、競合分析そのものを「競合では〜」のように書かず、分析結果を自然に反映してください。',
    '取得状況（HTTP 403、取得失敗、取得できませんでした等）は内部処理メモです。本文には絶対に書かないでください。',
    'URL本文を取得できない場合でも、URL文字列・タイトル・URLヒントから分かる範囲で論点を推定して構成材料にして構いません。ただし取得できなかったページ内容を事実として断定しないでください。',
    '公式サイトや店舗公式ページが含まれる場合は、本文内で重要なサービス名・プラン名・確認先として自然に触れてください。',
    '取得した公式ページのタイトル、見出し、本文抽出に具体的なサービス名・プラン名・キャンペーン名・料金体系名がある場合は、該当する本文セクションで必ず1回以上触れてください。',
    '公式サービス名・プラン名・料金体系名が記事テーマの中心に近い場合は、独立したH2またはH3を作り、「何が含まれるか」「対象外や追加費用になりやすい条件」「見積もり前に確認すること」まで具体的に説明してください。',
    '具体的なサービス名・プラン名を本文に入れるときは、宣伝ではなく「公式ページで確認できる選択肢」「見積もり前に確認したい項目」として扱ってください。',
    '取得できた公式サービス名・プラン名を本文に反映しなかった場合は、fact_check_points に「・競合URLの公式サービス名未反映｜該当URL」と出してください。',
    '競合・参考URL欄に入力されたURLは、本文内の外部リンクとして使わないでください。公式サイトや店舗公式ページであっても、競合・参考URL欄に入力されたURLは分析材料に留めます。',
    '本文に外部リンクを入れる場合は、外部出典シートの候補、または記事内で確実に分かる公的機関・メーカー公式・店舗公式などの信頼性補強リンクだけを使ってください。',
    '競合URLをそのまま <a href> に入れる、競合URLを「あわせて読みたい」「公式ページ」などの本文リンクにする、競合URLのドメインへ読者を流すことは禁止です。',
    '丸写し、長い引用、事実の断定しすぎは避けてください。',
    '取得できなかったURLがある場合は、そのURLの内容を推測で本文に入れず、必要なら fact_check_points に確認事項として出してください。'
  ].join('\n');
}

function uaBuildReaderMindUsageRules_() {
  return `
読者心理メモの使い方:
・読者心理メモがある場合は、記事設計の中心材料として使う。
・導入文では「導入文で拾う本音」「読者の葛藤」から、読者が最初に感じている不安・迷いを具体的に拾う。
・本文構成では「見出し順のヒント」をそのまま丸写しせず、検索意図と競合・参考URLの構成を見たうえで、自然なH2/H3に再構成する。
・本文では「顕在ニーズ」に早めに答え、「潜在ニーズ」「読者の葛藤」は比較表、向いているケース、慎重に考えたいケース、注意点、まとめで回収する。
・「記事で深掘りすると刺さる判断軸」は、本文の独自性を出す重要材料として使う。単なる一般論で終わらせず、読者が自分で判断できる形にする。
・「本文で優先して扱う材料」がある場合は、本文の主軸、冒頭の答え、前半H2、比較表、判断軸に優先して反映する。
・「FAQに回す材料」がある場合は、FAQ候補と合わせて、本文で深掘りしすぎると主題が散る補足疑問として回収する。
・「今回は主役にしない材料」がある場合は、本文の主軸にしない。必要なら一文の注意、内部リンク、関連補足、fact_check_pointsに回す。
・「FAQ候補」はよくある質問の材料として優先的に使う。ただし本文で十分に解決した内容は重複させすぎない。
・「主役にしない補足テーマ」は、本文の主軸にせず、必要なら内部リンク候補・補足・一文の注意として軽く扱う。
・「本文で事実として使わない方がよいもの」は、本文で断定しない。古い情報、個人の体験談、Q&Aサイト由来の未確認情報は一般傾向として書かない。
・安全、法規、価格、保証、メーカー仕様などは、読者心理メモよりも公式情報・外部出典・確認ポイントを優先する。
・読者心理メモの見出し名（顕在ニーズ、潜在ニーズ等）は本文にそのまま出さない。記事の自然な文章として反映する。
`;
}

function uaBuildPreparedStructurePrompt_(rowData) {
  const memo = String(rowData && rowData.structureMemo || '').trim();

  if (!memo) {
    return '事前構成メモは未作成です。読者心理メモと競合・参考URLから本文構成を作ってください。';
  }

  return [
    '事前構成メモ（記事構成作成ボタンで作成済み）:',
    memo,
    '',
    '本文生成では、上記の事前構成メモを優先して使ってください。',
    'ただし、本文生成時に取得した外部出典、内部リンク、案件条件、安全・法規・保証の制約と矛盾する場合は、事実確認と安全側の表現を優先してください。',
    '事前構成メモを本文にそのまま貼らず、自然なH2/H3構成と本文に再構成してください。'
  ].join('\n');
}

function uaBuildArticlePlanningOrderRules_() {
  return `
記事構成を作る順序:
1. まず読者心理メモを読み、誰のどんな悩みに答える記事かを固定する。顕在ニーズ、潜在ニーズ、読者の葛藤、導入文で拾う本音、本文で優先して扱う材料、FAQに回す材料、今回は主役にしない材料、使わない方がよい情報を整理する。
2. 次に競合・参考URLを読み、上位記事や公式ページで共通して扱われている必須論点、公式サービス名、費用・プラン・対応可否などの確認事項を整理する。
3. 読者心理メモと競合・参考URLを照合し、読者の不安を解く順番に見出しを組み直す。競合URLの見出し順をそのままなぞらない。
4. 法規、安全、価格、保証、メーカー仕様、施工可否などの事実系は、外部出典・公式情報・確認ポイントを優先する。読者心理メモや競合記事だけを根拠に断定しない。
5. 内部リンク、外部リンク、案件リンクは、本文構成が決まった後に、読者の次の確認や選択肢として自然な位置へ置く。リンクを先に主役にしない。
6. 最後に、DRIVE BASE/たくみパパ/汎用記事としての独自視点を足す。単なる上位記事の要約ではなく、読者が自分で判断できる軸を入れる。

競合・参考URLの扱い:
・競合・参考URLはコピー元ではなく、検索意図、必須論点、不足論点を把握するための材料として使う。
・競合記事の文章、見出しの言い回し、比較表、独自レビュー、体験談をコピーしない。
・競合URLから得た情報は、読者心理メモ、公式情報、外部出典、独自の判断軸をもとに抽象化して再構成する。
・競合記事だけに書かれている未確認情報は、事実として断定しない。必要なら fact_check_points に確認事項として出す。
・競合・参考URL欄に入力されたURLは、本文中の外部リンクとして使わない。競合URLは分析材料であり、読者導線ではない。
・本文に外部リンクを入れる場合は、外部出典シートの候補、または記事内で確実に分かる公的機関・メーカー公式・店舗公式などの信頼性補強リンクだけを使う。
`;
}

